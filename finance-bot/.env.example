# Copy this file to .env and fill in your own free-tier keys/tokens.
# Never commit the real .env file.

# Stock footage (free tier)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# TikTok Content Posting API (free, direct-post scope)
TIKTOK_ACCESS_TOKEN=

# Instagram Graph API (free, requires a Facebook app + IG business account)
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

# YouTube uses an OAuth client_secret.json file instead of an env var
# (see README.md) — the resulting token is cached to secrets/youtube_token.json.
