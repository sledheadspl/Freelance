# Copy this file to .env and fill in real values. .env is gitignored.

# --- Supabase (required) ---
# Supabase dashboard → your project → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Google Maps on Android (required for Android dev/production builds) ---
# Google Cloud Console → enable "Maps SDK for Android" → create an API key.
# iOS uses Apple Maps and needs no key. Expo Go on Android uses Expo's key.
GOOGLE_MAPS_ANDROID_API_KEY=

# --- Expo push notifications (required for remote push) ---
# Run `npx eas init` once; it prints your project ID.
EAS_PROJECT_ID=
