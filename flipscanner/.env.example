# Supabase project settings (Project Settings > API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only secrets (used by Supabase Edge Functions, never bundled in the app)
# ANTHROPIC_API_KEY=
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# APIFY_TOKEN=
# APIFY_SOLD_LISTINGS_ACTOR_ID=
