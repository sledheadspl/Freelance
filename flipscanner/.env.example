# Supabase project settings (Project Settings > API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only secrets (used by Supabase Edge Functions, never bundled in the app)
# ANTHROPIC_API_KEY=
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# APIFY_TOKEN=
# APIFY_SOLD_LISTINGS_ACTOR_ID=

# eBay user OAuth ("Connect eBay", spec section 9) — sandbox by default
# EBAY_ENV=sandbox
# EBAY_OAUTH_REDIRECT_URI=
# EBAY_OAUTH_STATE_SECRET=

# Publish to eBay (step 9) — seller account / business policy config
# EBAY_MARKETPLACE_ID=EBAY_US
# EBAY_MERCHANT_LOCATION_KEY=
# EBAY_FULFILLMENT_POLICY_ID=
# EBAY_PAYMENT_POLICY_ID=
# EBAY_RETURN_POLICY_ID=
# EBAY_DEFAULT_CATEGORY_ID=

# Stripe (create-checkout-session, create-portal-session, stripe-webhook)
# STRIPE_SECRET_KEY=
# STRIPE_PRO_PRICE_ID=
# STRIPE_WEBHOOK_SECRET=
